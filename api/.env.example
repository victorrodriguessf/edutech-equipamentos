DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/edutech?schema=public"
# Para gerar chaves seguras, rode: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="sua_chave_secreta_jwt"
JWT_REFRESH_SECRET="sua_chave_secreta_refresh_jwt"
PORT=3333
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
SEED_SENHA_ADMIN="senha_do_admin"
SEED_SENHA_OPERADOR="senha_do_operador"
# Se for "true", o seed reescreve a senha de usuários que já existem (útil em dev).
# Em outros ambientes, mantenha "false" para não sobrescrever senhas alteradas pelos usuários.
SEED_FORCAR_SENHA="false"
